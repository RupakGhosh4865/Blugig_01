# Public site URL (canonical URLs, sitemap, OG). Defaults to https://www.avantratechnologies.com
# (content/site.ts); set it only to point a staging build elsewhere. Inlined at build time: redeploy after changing.
NEXT_PUBLIC_SITE_URL=

# Contact form delivery — configure either or both. With neither set, leads are logged to the server console.
CONTACT_WEBHOOK_URL=
RESEND_API_KEY=
# Optional: defaults to the site email (content/site.ts)
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL="Avantra Website <website@yourdomain.com>"

# Optional: overrides the Calendly booking link in content/site.ts — the scheduler under the contact
# form and the "Book an integration assessment" buttons (inlined at build time: redeploy after changing)
NEXT_PUBLIC_CALENDLY_URL=

# Blog admin (/admin). The password turns the admin on; use a long random one. Changing it signs everyone out.
ADMIN_PASSWORD=
# Optional: a separate random secret for signing admin sessions (otherwise derived from ADMIN_PASSWORD).
ADMIN_SESSION_SECRET=

# Blog storage. On Railway, add a Postgres database to the project and reference its DATABASE_URL here;
# the blog_posts table is created (with the example post) on first use.
DATABASE_URL=
# Without DATABASE_URL, posts are JSON files in ./.data/blog — fine locally. On a server, point this at a
# persistent volume instead; with neither set in production, the admin refuses to save (the disk is wiped on deploy).
BLOG_DATA_DIR=
