# Public site URL (canonical URLs, sitemap, OG)
NEXT_PUBLIC_SITE_URL=

# Contact form delivery — configure either or both. With neither set, leads are logged to the server console.
CONTACT_WEBHOOK_URL=
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL="Avantra Website <website@yourdomain.com>"

# Optional: Calendly embed under the contact form
NEXT_PUBLIC_CALENDLY_URL=
