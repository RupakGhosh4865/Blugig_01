# Public site URL (canonical URLs, sitemap, OG). On Railway, set it to the custom domain once one is
# attached; until then the site falls back to Railway's RAILWAY_PUBLIC_DOMAIN. Changing it needs a redeploy.
NEXT_PUBLIC_SITE_URL=

# Contact form delivery — configure either or both. With neither set, leads are logged to the server console.
CONTACT_WEBHOOK_URL=
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL="Avantra Website <website@yourdomain.com>"

# Optional: Calendly booking link — the scheduler under the contact form and the home
# "Book an integration assessment" button (inlined at build time: redeploy after changing)
NEXT_PUBLIC_CALENDLY_URL=
